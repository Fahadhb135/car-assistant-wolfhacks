# Only public, non-secret values may use the EXPO_PUBLIC_ prefix.
# API keys for Gemini, ElevenLabs, and Databricks belong on a remote backend.
EXPO_PUBLIC_API_URL=

# Unique iOS bundle identifier for your local development build,
# e.g. com.yourname.carassistant. Not a secret, but specific to your Apple team.
IOS_BUNDLE_IDENTIFIER=
