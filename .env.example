# Only public, non-secret values may use the EXPO_PUBLIC_ prefix.
# API keys for Gemini, ElevenLabs, and Databricks belong on a remote backend.
EXPO_PUBLIC_API_URL=

# Server-side / scripts only (cloud service, `npm run phrases`). Never EXPO_PUBLIC_*.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GEMINI_API_KEY=
# Full workspace URL (https://dbc-....cloud.databricks.com), NOT the numeric workspace id
DATABRICKS_HOST=
DATABRICKS_TOKEN=
# /Volumes/<catalog>/<schema>/<volume>, from the Catalog explorer
DATABRICKS_VOLUME_PATH=
