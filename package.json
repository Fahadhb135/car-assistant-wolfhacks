{
  "name": "car-assistant-wolfhacks",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "npm run test:node && npm run test:vitest",
    "typecheck": "tsc --noEmit",
    "test:node": "tsx --test 'src/core/location/**/*.test.ts' 'src/integrations/location/**/*.test.ts' 'src/integrations/bluetooth/**/*.test.ts'",
    "test:vitest": "vitest run",
    "phrases": "tsx scripts/generate-phrases.mts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "base64-js": "^1.5.1",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "@google/genai": "^2.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^2.1.0"
  }
}
